<!DOCTYPE html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<style>
:root{--c1:#1fb6ff;--c2:#5a4bff;--c3:#b23dff;--ink:#e8f3ff;--mut:#8fa6d8;--bg:#02030f}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;background:var(--bg);color:var(--ink);font-family:Roboto,"Segoe UI",system-ui,sans-serif;overflow:hidden}
#bg{position:fixed;inset:0;width:100%;height:100%;z-index:0}
.aura{position:fixed;inset:0;z-index:0;background:radial-gradient(60% 40% at 85% 4%,rgba(90,75,255,.38),transparent 70%),radial-gradient(70% 45% at 5% 42%,rgba(31,182,255,.22),transparent 70%),radial-gradient(70% 40% at 70% 96%,rgba(178,61,255,.32),transparent 70%)}
.grid{position:fixed;left:-50%;right:-50%;bottom:-8%;height:42%;z-index:0;opacity:.32;background-image:linear-gradient(rgba(31,182,255,.5) 1px,transparent 1px),linear-gradient(90deg,rgba(31,182,255,.5) 1px,transparent 1px);background-size:46px 46px;transform:perspective(380px) rotateX(62deg);animation:gm 4s linear infinite;-webkit-mask-image:linear-gradient(to top,#000,transparent 85%)}
@keyframes gm{to{background-position:0 46px}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes pulse{0%,100%{opacity:.55;transform:scale(.94)}50%{opacity:1;transform:scale(1.04)}}
@keyframes float{0%,100%{transform:translate(-50%,-50%) translateY(0)}50%{transform:translate(-50%,-50%) translateY(-7px)}}
@keyframes shine{to{background-position:200% 0}}
@keyframes scan{0%{top:6%;opacity:0}15%{opacity:1}85%{opacity:1}100%{top:72%;opacity:0}}
@keyframes wave{0%,100%{height:5px}50%{height:20px}}
@keyframes blink{50%{opacity:.25}}
.view{position:fixed;inset:0;overflow-y:auto;padding:34px 14px 140px;z-index:1;scrollbar-width:none}
.view::-webkit-scrollbar{display:none}
#appsV{display:none}
.glass{position:relative;border-radius:22px;background:rgba(9,16,52,.66);box-shadow:0 0 24px rgba(31,182,255,.16),inset 0 0 34px rgba(90,75,255,.12)}
.glass::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1.5px;background:linear-gradient(135deg,var(--c1),var(--c2),var(--c3));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}
.tap{transition:transform .12s}.tap:active{transform:scale(.95)}
.top{display:flex;align-items:flex-start;justify-content:space-between}
.clock{font-size:66px;font-weight:200;line-height:1;letter-spacing:1px;background:linear-gradient(180deg,#fff,#9fd8ff);-webkit-background-clip:text;color:transparent;filter:drop-shadow(0 0 14px rgba(31,182,255,.55))}
.clock small{font-size:18px;font-weight:400;margin-left:6px;letter-spacing:0;color:var(--c1);-webkit-text-fill-color:var(--c1)}
.date{margin-top:6px;font-size:15px;color:#9fc4ff}.greet{font-size:14px;color:var(--c1);margin-top:2px}
.wx{width:128px;padding:12px 8px;text-align:center}.wx b{display:block;font-size:30px;font-weight:300}.wx span{font-size:12px;color:var(--mut)}
.pill{margin-top:16px;display:flex;align-items:center;justify-content:center;gap:12px;padding:11px 16px;font-size:13px;color:#d6ebff;border-radius:30px}
.wv{display:flex;gap:3px;align-items:center;height:22px}.wv i{width:3px;border-radius:2px;background:linear-gradient(var(--c1),var(--c3));animation:wave 1.1s ease-in-out infinite}
.wv i:nth-child(2){animation-delay:.15s}.wv i:nth-child(3){animation-delay:.3s}.wv i:nth-child(4){animation-delay:.45s}.wv i:nth-child(5){animation-delay:.6s}
.stat{margin-top:12px;font-size:12px;color:var(--mut);text-align:center}.stat i{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;background:#ffc53d;box-shadow:0 0 8px currentColor;animation:blink 1.6s infinite}.stat.on i{background:#2be36b}
.hero{position:relative;height:340px;margin-top:2px}
.rb{position:absolute;left:50%;top:45%;width:300px;height:300px;transform:translate(-50%,-50%)}
.ring{position:absolute;border-radius:50%}
.r1{inset:0;border:2px dashed rgba(31,182,255,.55);animation:spin 20s linear infinite}
.r2{inset:22px;border:2px solid transparent;border-top-color:var(--c3);border-bottom-color:var(--c1);animation:spin 8s linear infinite reverse;filter:drop-shadow(0 0 6px var(--c1))}
.r3{inset:50px;border:1px dotted rgba(178,61,255,.8);animation:spin 28s linear infinite}
.gl{inset:36px;background:radial-gradient(circle,rgba(31,182,255,.40),rgba(90,75,255,.16) 55%,transparent 70%);animation:pulse 3.2s ease-in-out infinite}
.rob{position:absolute;left:50%;top:45%;width:340px;height:243px;transform:translate(-50%,-50%);animation:float 5s ease-in-out infinite;-webkit-mask-image:radial-gradient(ellipse 50% 52% at 50% 50%,#000 56%,transparent 100%)}
.rob img{width:100%;height:100%;object-fit:cover;display:block}
.scan{position:absolute;left:14%;right:14%;height:2px;background:linear-gradient(90deg,transparent,var(--c1),transparent);box-shadow:0 0 16px var(--c1);animation:scan 3.8s ease-in-out infinite}
.brand{position:absolute;left:0;right:0;bottom:0;text-align:center}
.brand b{display:inline-block;font-size:42px;font-style:italic;font-weight:800;letter-spacing:5px;background:linear-gradient(90deg,#fff,#7fd6ff,#c9a0ff,#fff);background-size:200% 100%;-webkit-background-clip:text;color:transparent;animation:shine 4s linear infinite;filter:drop-shadow(0 0 12px rgba(31,182,255,.7))}
.brand p{font-size:13px;color:#cfe6ff;margin-top:-2px}.brand em{font-size:13px;color:var(--c1)}
.search{margin-top:16px;display:flex;align-items:center;gap:10px;padding:4px 6px 4px 18px;border-radius:30px}
.search input{flex:1;min-width:0;background:none;border:0;outline:0;color:#fff;font-size:15px;padding:13px 0}
.search input::placeholder{color:#7f95c8}
.go{width:42px;height:42px;border-radius:50%;border:0;background:linear-gradient(135deg,var(--c1),var(--c3));display:grid;place-items:center;box-shadow:0 0 14px rgba(90,75,255,.7)}
svg.i{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.dock{display:flex;gap:8px;margin-top:16px}
.dock .t{flex:1;min-width:0;height:78px;border-radius:18px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;font-size:10px;color:#fff;text-align:center}
.dock img{width:40px;height:40px;border-radius:11px;box-shadow:0 0 12px rgba(31,182,255,.35)}
.dock .more{color:var(--c1);font-weight:700;font-size:12px}
.card{margin-top:16px;padding:16px}
.ct{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:700;color:#7fd6ff;letter-spacing:.4px}
.ct .live{margin-left:auto;font-size:10px;color:#2be36b;border:1px solid #2be36b66;border-radius:10px;padding:2px 8px;animation:blink 2s infinite}
.row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid rgba(90,120,255,.14)}
.row:last-of-type{border:0}
.ic{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;flex:none;color:#fff;background:linear-gradient(135deg,rgba(31,182,255,.35),rgba(178,61,255,.35));box-shadow:0 0 10px rgba(90,75,255,.4)}
.ic svg{width:18px;height:18px}
.row div{font-size:13px;color:var(--mut);min-width:0}.row b{display:block;font-size:15px;color:#fff;font-weight:600;margin-top:1px;overflow:hidden;text-overflow:ellipsis}
.note{font-size:11px;color:var(--mut);margin-top:6px;white-space:pre-line}
.btns{display:flex;gap:10px;margin-top:12px}
.btn{flex:1;border:0;border-radius:16px;padding:13px 6px;font-size:13px;font-weight:600;color:#fff;background:linear-gradient(135deg,rgba(31,182,255,.5),rgba(90,75,255,.55) 55%,rgba(178,61,255,.55));box-shadow:0 0 16px rgba(90,75,255,.5)}
.qg{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:14px}
.q{aspect-ratio:1;border-radius:18px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;font-size:11px;color:#dff0ff;background:rgba(20,34,96,.55);border:1px solid rgba(90,120,255,.35)}
.q svg{width:24px;height:24px;color:var(--c1);filter:drop-shadow(0 0 6px var(--c1))}
.gs{display:flex;justify-content:space-around;margin-top:14px}
.g{text-align:center;font-size:12px;color:var(--mut)}.g svg{width:84px;height:84px;transform:rotate(-90deg)}
.g .bgc{fill:none;stroke:rgba(90,120,255,.2);stroke-width:7}.g .fg{fill:none;stroke-width:7;stroke-linecap:round;transition:stroke-dasharray 1s,stroke .5s;filter:drop-shadow(0 0 5px currentColor)}
.g .v{margin-top:-58px;margin-bottom:34px;font-size:16px;font-weight:700;color:#fff;position:relative}
.nav{position:fixed;left:12px;right:12px;bottom:calc(10px + env(safe-area-inset-bottom,0px));height:70px;z-index:5;border-radius:26px;display:flex;align-items:center;background:rgba(6,10,40,.86)}
.nav .n{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;font-size:10px;color:var(--mut)}
.nav .n.on{color:var(--c1);text-shadow:0 0 10px var(--c1)}.nav .sp{flex:1.1}
.orb{position:fixed;left:50%;bottom:calc(36px + env(safe-area-inset-bottom,0px));margin-left:-38px;width:76px;height:76px;z-index:6;border-radius:50%;display:grid;place-items:center;border:0;color:#fff;background:radial-gradient(circle at 35% 30%,#7fd6ff,#3a5bff 55%,#6a1fd0);box-shadow:0 0 28px rgba(31,182,255,.8),0 0 60px rgba(120,60,255,.55)}
.orb::before{content:"";position:absolute;inset:-7px;border-radius:50%;border:2px solid transparent;border-top-color:var(--c1);border-right-color:var(--c3);animation:spin 3s linear infinite}
.orb::after{content:"";position:absolute;inset:-15px;border-radius:50%;border:1px solid rgba(31,182,255,.4);animation:pulse 2.4s ease-in-out infinite}
.orb svg{width:32px;height:32px;fill:#fff;stroke:#fff}
.otag{position:fixed;left:0;right:0;bottom:calc(14px + env(safe-area-inset-bottom,0px));text-align:center;font-size:9px;letter-spacing:2px;color:#9fc4ff;z-index:7;pointer-events:none}
.ah{display:flex;align-items:center;gap:10px}.ah .back{width:42px;height:42px;border-radius:14px;border:0;color:#fff;font-size:22px}
.ah input{flex:1;min-width:0;border:0;outline:0;color:#fff;font-size:15px;padding:12px 16px;border-radius:24px;background:rgba(9,16,52,.7)}
.ag{display:grid;grid-template-columns:repeat(4,1fr);gap:14px 6px;margin-top:18px}
.ag div{text-align:center;font-size:11px;color:#e8f3ff;min-width:0}.ag img{width:50px;height:50px;border-radius:13px;display:block;margin:0 auto 5px;background:rgba(90,120,255,.15)}
.ag span{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}

/* v7.210 HOLO: video-style blue hologram orb (add-only layer over the old rings) */
#holo{position:absolute;left:50%;top:45%;width:300px;height:300px;transform:translate(-50%,-50%);z-index:2;pointer-events:none;filter:drop-shadow(0 0 12px rgba(47,184,255,.55))}
.rob{display:none}

/* v7.210 LIVE WALLPAPER: animated power grid behind the home screen (add-only, sits under the old stars) */
#wp{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
</style></head><body>
<canvas id="wp" aria-hidden="true"></canvas><canvas id="bg"></canvas><div class="aura"></div><div class="grid"></div>
<div class="view" id="homeV">
 <div class="top"><div><div class="clock" id="clk">--:--<small></small></div><div class="date" id="dt" ondblclick="LB.act('classic','')"></div><div class="greet" id="gr">Namaste, boss</div></div>
  <div class="glass wx tap" onclick="LB.act('city','')"><b id="tp">--°</b><span id="wt">Mausam: tap karo</span></div></div>
 <div class="glass pill tap" onclick="LB.act('orb','')"><div class="wv"><i></i><i></i><i></i><i></i><i></i></div>Say: "Open YouTube" or "Play GTA 5"<div class="wv"><i></i><i></i><i></i></div></div>
 <div class="stat" id="stat"><i></i><span>Jarvis...</span></div>
 <div class="hero"><div class="rb"><div class="ring gl"></div><div class="ring r1"></div><div class="ring r2"></div><div class="ring r3"></div></div>
  <canvas id="holo" aria-hidden="true"></canvas><div class="rob"><img src="https://jarvis.local/hero.jpg"></div><div class="scan"></div>
  <div class="brand"><b>JARVIS</b><p>Your Personal AI Assistant</p><em>Always With You...</em></div></div>
 <div class="glass search"><svg class="i" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input id="sq" placeholder="Search apps ya Jarvis ko kaam likho..." enterkeyhint="go" autocomplete="off"><button class="go tap" onclick="sub()"><svg class="i" viewBox="0 0 24 24" style="stroke:#fff"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button></div>
 <div class="dock" id="dock"></div>
 <div class="glass card"><div class="ct"><svg class="i" viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>Aaj ka business<span class="live">LIVE</span></div>
  <div class="row tap" onclick="LB.act('biz','ORDERS')"><span class="ic"><svg class="i" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span><div id="b1"></div></div>
  <div class="row tap" onclick="LB.act('biz','LEADS')"><span class="ic"><svg class="i" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span><div id="b2"></div></div>
  <div class="row tap" onclick="LB.act('biz','AUTOPILOT')"><span class="ic"><svg class="i" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></span><div id="b3"></div></div>
  <div class="row tap" onclick="LB.act('biz','REPORT')"><span class="ic"><svg class="i" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></span><div id="b4"></div></div>
  <div class="note" id="bn"></div>
  <div class="btns"><button class="btn tap" onclick="LB.act('biz','FIND')">Leads dhoondo</button><button class="btn tap" onclick="LB.act('biz','REPORT')">Report sunao</button></div></div>
 <div class="glass card"><div class="ct"><svg class="i" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>Quick Actions</div><div class="qg" id="qg"></div></div>
 <div class="glass card"><div class="ct"><svg class="i" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/></svg>System Status</div>
  <div class="gs"><div class="g"><svg viewBox="0 0 100 100"><circle class="bgc" cx="50" cy="50" r="40"/><circle class="fg" id="g1" cx="50" cy="50" r="40" stroke-dasharray="0 251"/></svg><div class="v" id="v1">--</div>Battery</div>
  <div class="g"><svg viewBox="0 0 100 100"><circle class="bgc" cx="50" cy="50" r="40"/><circle class="fg" id="g2" cx="50" cy="50" r="40" stroke-dasharray="0 251"/></svg><div class="v" id="v2">--</div>RAM</div>
  <div class="g"><svg viewBox="0 0 100 100"><circle class="bgc" cx="50" cy="50" r="40"/><circle class="fg" id="g3" cx="50" cy="50" r="40" stroke-dasharray="0 251"/></svg><div class="v" id="v3">--</div>Storage</div></div></div>
 <div class="glass card"><div class="ct"><svg class="i" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>Laptop Control</div>
  <div class="note" id="lp" style="font-size:13px;color:#cfe0ff;margin-top:10px"></div>
  <div class="btns"><button class="btn tap" onclick="lap()">Laptop par kaam bolo</button></div></div>
</div>
<div class="view" id="appsV"><div class="ah"><button class="glass back tap" onclick="show('home')">‹</button><input id="aq" placeholder="Apps dhundo..." autocomplete="off"></div><div class="ag" id="ag"></div></div>
<div class="glass nav"><div class="n on" id="nh" onclick="show('home')"><svg class="i" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>Home</div>
 <div class="n" id="na" onclick="show('apps')"><svg class="i" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>Apps</div><div class="sp"></div>
 <div class="n" onclick="LB.act('quick','chat')"><svg class="i" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>Chat</div>
 <div class="n" onclick="LB.act('quick','chat')"><svg class="i" viewBox="0 0 24 24"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>Setup</div></div>
<button class="orb tap" onclick="LB.act('orb','')"><svg viewBox="0 0 24 24" class="i"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></button><div class="otag" id="ot">JARVIS</div>
<script>
const $=id=>document.getElementById(id),esc=t=>String(t).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
const LBX=window.LB||{apps:()=>"[]",cmd:()=>false,act:()=>{}};window.LB=LBX;
const QS=[['camera','Camera','<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/>'],['call','Call','<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>'],['message','Message','<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>'],['wifi','WiFi','<path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>'],['dark','Dark mode','<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>'],['torch','Torch','<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>'],['chat','Jarvis chat','<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/>'],['apps','Sab apps','<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>']];
$('qg').innerHTML=QS.map(q=>`<div class="q tap" data-k="${q[0]}"><svg class="i" viewBox="0 0 24 24">${q[2]}</svg>${q[1]}</div>`).join('');
$('qg').onclick=e=>{const d=e.target.closest('.q');if(!d)return;const k=d.dataset.k;k==='apps'?show('apps'):LB.act('quick',k)};
function show(v){const a=v==='apps';$('homeV').style.display=a?'none':'block';$('appsV').style.display=a?'block':'none';$('nh').classList.toggle('on',!a);$('na').classList.toggle('on',a);if(a){$('aq').value='';apps('')}else $('homeV').scrollTop=0}
function apps(q){let l=[];try{l=JSON.parse(LB.apps(q))}catch(e){}$('ag').innerHTML=l.map(a=>`<div class="tap" data-p="${esc(a.p)}"><img loading="lazy" src="https://jarvis.local/icon/${encodeURIComponent(a.p)}"><span>${esc(a.n)}</span></div>`).join('')}
$('ag').onclick=e=>{const d=e.target.closest('[data-p]');if(d)LB.act('open',d.dataset.p)};
$('aq').oninput=e=>apps(e.target.value);
$('sq').oninput=e=>{const q=e.target.value;if(q.trim()&&!LB.cmd(q)){show('apps');$('aq').value=q;apps(q)}};
function sub(){const t=$('sq').value.trim();if(!t)return;LB.act('submit',t);$('sq').value=''}
$('sq').onkeydown=e=>{if(e.key==='Enter')sub()};
function lap(){const s=$('sq');s.value='laptop par ';s.focus()}
window.goHome=()=>{show('home')};window.onBack=()=>{if($('appsV').style.display==='block')show('home')};
function tick(){const d=new Date();let h=d.getHours();const ap=h>=12?'PM':'AM';h=h%12||12;$('clk').innerHTML=String(h).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0')+'<small>'+ap+'</small>';$('dt').textContent=d.toLocaleDateString('en-GB',{weekday:'long',day:'numeric',month:'short'})}
tick();setInterval(tick,1000);
function biz(id,t){const e=$(id),i=t.indexOf(': ');e.innerHTML=i<0?'<b>'+esc(t)+'</b>':esc(t.slice(0,i))+'<b>'+esc(t.slice(i+2))+'</b>'}
function gauge(n,p,hi){p=Math.max(0,Math.min(100,p|0));const g=$('g'+n),good=hi?p:100-p,c=good>=50?'#2be36b':good>=20?'#ffc53d':'#ff4d4d';g.style.stroke=c;g.style.color=c;g.setAttribute('stroke-dasharray',(p*2.51)+' 251');$('v'+n).textContent=p+'%'}
window.setState=s=>{if(s.greet)$('gr').textContent=s.greet;$('tp').textContent=s.temp||'--°';$('wt').textContent=s.wtext||'';
 const st=$('stat');st.className='stat'+(s.run?' on':'');st.lastElementChild.textContent=(s.status||'')+(s.last?'  ·  '+s.last:'');
 biz('b1',s.orders||'');biz('b2',s.leads||'');biz('b3',s.auto||'');biz('b4',s.report||'');$('bn').textContent=s.info||'';
 gauge(1,s.bat,1);gauge(2,s.ram,0);gauge(3,s.sto,0);$('lp').textContent=s.laptop||'';$('ot').textContent=s.run?'BOLO / TAP KARO':'JARVIS CHALU KARO';
 $('dock').innerHTML=(s.dock||[]).map(a=>`<div class="glass t tap" data-p="${esc(a.p)}"><img src="https://jarvis.local/icon/${encodeURIComponent(a.p)}">${esc(a.n)}</div>`).join('')+'<div class="glass t more tap" id="mr"><svg class="i" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>More</div>'};
$('dock').onclick=e=>{const d=e.target.closest('.t');if(!d)return;d.id==='mr'?show('apps'):LB.act('open',d.dataset.p)};
(function(){const c=$('bg'),x=c.getContext('2d');let W,H,P=[];function rs(){W=c.width=innerWidth;H=c.height=innerHeight;P=Array.from({length:55},()=>({x:Math.random()*W,y:Math.random()*H,r:Math.random()*1.6+.4,v:Math.random()*.25+.05,a:Math.random()}))}rs();addEventListener('resize',rs);
function f(){if(document.hidden){requestAnimationFrame(f);return}x.clearRect(0,0,W,H);for(const p of P){p.y-=p.v;p.a+=.02;if(p.y<0){p.y=H;p.x=Math.random()*W}x.globalAlpha=.35+.35*Math.sin(p.a);x.fillStyle=p.r>1.3?'#7fd6ff':'#b99bff';x.beginPath();x.arc(p.x,p.y,p.r,0,6.3);x.fill()}requestAnimationFrame(f)}f()})();
</script><script>
/* v7.210 HOLO: draws the video-style hologram: particle sphere, rotating rings, glowing cross core. Pure canvas, no network. */
(function(){
  var cv=document.getElementById('holo'); if(!cv||!cv.getContext) return;
  var cx=cv.getContext('2d'), dpr=Math.min(window.devicePixelRatio||1,2), W=300, H=300;
  cv.width=W*dpr; cv.height=H*dpr; cx.setTransform(dpr,0,0,dpr,0,0);
  var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
  var N=150,P=[],i;
  for(i=0;i<N;i++){var u=Math.random()*2-1,a=Math.random()*6.2832,r=Math.sqrt(1-u*u);P.push([r*Math.cos(a),u,r*Math.sin(a)]);}
  var t0=performance.now();
  function rgba(c,a){return 'rgba('+c[0]+','+c[1]+','+c[2]+','+Math.max(0,Math.min(1,a))+')';}
  var BLUE=[47,184,255], ICE=[191,246,255], DEEP=[11,37,64];
  function frame(now){
    if(document.hidden){requestAnimationFrame(frame);return;}
    var e=(now-t0)/1000, cxn=W/2, cyn=H/2, R=104, pulse=1+0.03*Math.sin(e*2.2);
    cx.clearRect(0,0,W,H);
    var g=cx.createRadialGradient(cxn,cyn,0,cxn,cyn,148);
    g.addColorStop(0,rgba(BLUE,0.22*pulse)); g.addColorStop(0.7,rgba(BLUE,0.04)); g.addColorStop(1,rgba(BLUE,0));
    cx.fillStyle=g; cx.fillRect(0,0,W,H);
    cx.lineWidth=1.3;
    for(var rg=0;rg<3;rg++){
      var rr=R*(1.22+rg*0.14), d=rg%2?-1:1, st=e*d*(0.5+rg*0.2);
      cx.strokeStyle=rgba(BLUE,0.6-rg*0.14); cx.setLineDash([R*0.2,R*0.12]);
      cx.beginPath(); cx.arc(cxn,cyn,rr,st,st+5.2); cx.stroke();
    }
    cx.setLineDash([]);
    var ay=reduce?0:e*0.5, ax=0.4, cY=Math.cos(ay), sY=Math.sin(ay), cX=Math.cos(ax), sX=Math.sin(ax), pr=[];
    for(i=0;i<N;i++){var q=P[i],x=q[0]*cY-q[2]*sY,z=q[0]*sY+q[2]*cY,y=q[1]*cX-z*sX,z2=q[1]*sX+z*cX;pr.push([cxn+x*R*pulse,cyn+y*R*pulse,z2]);}
    cx.lineWidth=0.6;
    for(i=0;i<N;i+=2)for(var j=i+1;j<N;j+=6){
      var dx=pr[i][0]-pr[j][0],dy=pr[i][1]-pr[j][1],dd=dx*dx+dy*dy,lim=R*R*0.1;
      if(dd<lim){cx.strokeStyle=rgba(ICE,0.2*(1-dd/lim));cx.beginPath();cx.moveTo(pr[i][0],pr[i][1]);cx.lineTo(pr[j][0],pr[j][1]);cx.stroke();}
    }
    for(i=0;i<N;i++){cx.fillStyle=rgba(ICE,0.3+0.6*(pr[i][2]+1)/2);cx.fillRect(pr[i][0]-0.8,pr[i][1]-0.8,1.7,1.7);}
    var core=cx.createRadialGradient(cxn,cyn,0,cxn,cyn,R*0.7);
    core.addColorStop(0,rgba(BLUE,0.85)); core.addColorStop(0.55,rgba(DEEP,0.5)); core.addColorStop(1,rgba(BLUE,0));
    cx.fillStyle=core; cx.beginPath(); cx.arc(cxn,cyn,R*0.7,0,6.2832); cx.fill();
    var cr=R*0.32*pulse;
    cx.strokeStyle=rgba(ICE,0.95); cx.lineWidth=2.6; cx.lineCap='round';
    cx.beginPath(); cx.moveTo(cxn-cr,cyn-cr); cx.lineTo(cxn+cr,cyn+cr); cx.moveTo(cxn+cr,cyn-cr); cx.lineTo(cxn-cr,cyn+cr); cx.stroke();
    cx.lineWidth=1.2; cx.beginPath(); cx.arc(cxn,cyn,cr*0.45,0,6.2832); cx.stroke();
    var sy=cyn-R*0.9+((e*90)%(R*1.8));
    var sg=cx.createLinearGradient(0,sy-6,0,sy+6); sg.addColorStop(0,rgba(BLUE,0)); sg.addColorStop(0.5,rgba(BLUE,0.45)); sg.addColorStop(1,rgba(BLUE,0));
    cx.fillStyle=sg; cx.fillRect(cxn-R*1.1,sy-6,R*2.2,12);
    if(!reduce) requestAnimationFrame(frame); else frame(now);
  }
  requestAnimationFrame(frame);
})();
</script>
<script>
/* v7.210 LIVE WALLPAPER: pulsing hex power grid, rising data streaks, energy waves from the core. Pure canvas, paused when hidden. */
(function(){
  var cv=document.getElementById('wp'); if(!cv||!cv.getContext) return;
  var cx=cv.getContext('2d'), dpr=Math.min(window.devicePixelRatio||1,2), W=0, H=0, cols=[], streaks=[], waves=[], last=0;
  var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
  function size(){W=innerWidth;H=innerHeight;cv.width=W*dpr;cv.height=H*dpr;cx.setTransform(dpr,0,0,dpr,0,0);
    streaks=[];var k=Math.max(18,Math.floor(W/16));for(var i=0;i<k;i++)streaks.push({x:Math.random()*W,y:Math.random()*H,v:40+Math.random()*90,l:30+Math.random()*90,a:Math.random()});}
  size(); addEventListener('resize',size);
  function hex(x,y,r){cx.beginPath();for(var i=0;i<6;i++){var a=Math.PI/3*i+Math.PI/6;cx.lineTo(x+r*Math.cos(a),y+r*Math.sin(a));}cx.closePath();cx.stroke();}
  function frame(now){
    if(document.hidden){requestAnimationFrame(frame);return;}
    var dt=last?Math.min(0.05,(now-last)/1000):0; last=now; var t=now/1000;
    cx.clearRect(0,0,W,H);
    var ccx=W/2, ccy=H*0.42;
    // pulsing core glow
    var pu=0.5+0.5*Math.sin(t*1.6);
    var g=cx.createRadialGradient(ccx,ccy,0,ccx,ccy,Math.max(W,H)*0.6);
    g.addColorStop(0,'rgba(47,184,255,'+(0.10+0.08*pu)+')');g.addColorStop(1,'rgba(47,184,255,0)');
    cx.fillStyle=g;cx.fillRect(0,0,W,H);
    // hex grid, brightness travels outward from the core
    var R=26, hw=R*Math.sqrt(3), rows=Math.ceil(H/(R*1.5))+2, colsN=Math.ceil(W/hw)+2;
    cx.lineWidth=1;
    for(var r=-1;r<rows;r++)for(var c=-1;c<colsN;c++){
      var x=c*hw+((r&1)?hw/2:0), y=r*R*1.5;
      var d=Math.hypot(x-ccx,y-ccy), ph=(d/160-t*0.9), w=0.5+0.5*Math.sin(ph*2*Math.PI);
      cx.strokeStyle='rgba(47,184,255,'+(0.04+0.16*w*w)+')';
      hex(x,y,R-2);
    }
    // rising data streaks
    cx.lineCap='round';
    for(var i=0;i<streaks.length;i++){var s=streaks[i];
      s.y-=s.v*dt; if(s.y+s.l<0){s.y=H+s.l;s.x=Math.random()*W;}
      cx.strokeStyle='rgba(191,246,255,'+(0.10+0.25*s.a)+')';cx.lineWidth=1.2;
      cx.beginPath();cx.moveTo(s.x,s.y);cx.lineTo(s.x,s.y+s.l);cx.stroke();}
    // energy waves from the core (power pulse every ~2.4s)
    if(!reduce && Math.floor(t/2.4)!==waves.lastSpawn){waves.lastSpawn=Math.floor(t/2.4);waves.push({t0:t});}
    for(var j=waves.length-1;j>=0;j--){var wv=waves[j],k2=(t-wv.t0)/2.6;
      if(k2>=1){waves.splice(j,1);continue;}
      cx.strokeStyle='rgba(47,184,255,'+(0.5*(1-k2))+')';cx.lineWidth=2.2*(1-k2)+0.5;
      cx.beginPath();cx.arc(ccx,ccy,40+k2*Math.max(W,H)*0.7,0,6.2832);cx.stroke();}
    if(!reduce) requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();
</script>
</body></html>
