# Optional. Only needed when you want a build signed with YOUR fixed key (in-app APK update needs the SAME key every time).
# Without these variables app/build.gradle.kts falls back to the normal debug key.
export NOVA_KEYSTORE_PATH="<ABSOLUTE_PATH_TO>/nova.jks"
export NOVA_KEYSTORE_PASSWORD="<YOUR_KEYSTORE_PASSWORD>"
export NOVA_KEY_ALIAS="<YOUR_KEY_ALIAS>"          # e.g. nova
export NOVA_KEY_PASSWORD="<YOUR_KEY_PASSWORD>"    # optional, defaults to the keystore password
export NOVA_VERSION_CODE="<INTEGER_HIGHER_THAN_INSTALLED>"   # optional, default 29
